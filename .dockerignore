# Keep the Docker build context small and reproducible.
# Anything the image builds itself (or that is platform-specific) is excluded.

**/node_modules
**/dist
backend/build
backend/cmake-build-*
**/*.o
**/*.obj
**/*.exe
**/*.dll
**/*.so
**/*.dylib
**/*.log
.git
.gitignore
.github
.vscode
.idea
img
ui-preview.html
start-dev.ps1
docker-compose.yml
README.md
